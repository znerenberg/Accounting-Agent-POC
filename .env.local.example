# Brex LLM Gateway configuration
# The gateway proxies requests to Anthropic's API
LLM_GATEWAY_URL=https://llm.staging.brexapps.io/gateway/anthropic
LLM_GATEWAY_API_KEY=your-gateway-api-key-here

# Optional: Snowflake CLI connection used for live customer history.
# Defaults to "brex" when omitted.
SNOWFLAKE_CONNECTION=brex
